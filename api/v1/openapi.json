{
  "openapi": "3.1.0",
  "info": {
    "title": "LLM API Pricing (static JSON API)",
    "version": "1.0.0",
    "description": "Read-only static JSON files generated from data/prices.json by scripts/build_api.py and served by GitHub Pages. All prices are USD per 1M tokens. Only GET is supported; there is no server-side filtering or query parameters, filter on the client. CORS: GitHub Pages sends Access-Control-Allow-Origin: * so files can be fetched from any origin. Dataset updated_at: 2026-10-11."
  },
  "servers": [
    {
      "url": ".",
      "description": "Relative to this openapi.json (…/api/v1/)"
    },
    {
      "url": "https://{user}.github.io/{repo}/api/v1",
      "variables": {
        "user": {
          "default": "your-user"
        },
        "repo": {
          "default": "llm-pricing"
        }
      }
    }
  ],
  "paths": {
    "/models.json": {
      "get": {
        "operationId": "listModels",
        "summary": "All models",
        "responses": {
          "200": {
            "description": "All models",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            }
          },
          "404": {
            "description": "Unknown vendor / model (GitHub Pages 404 page, not JSON)"
          }
        }
      }
    },
    "/models/{model_id}.json": {
      "get": {
        "operationId": "getModel",
        "summary": "One model by id",
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "deepseek-flash",
                "deepseek-v4-pro",
                "gpt-5.6-sol",
                "gpt-5.6-terra",
                "gpt-5.6-luna",
                "gpt-6-astra",
                "gpt-6-sol",
                "gpt-6-luna",
                "gpt-6.1-sol",
                "claude-fable-5.1",
                "claude-mythos-5.1",
                "claude-fable-5",
                "claude-mythos-5",
                "claude-opus-5.5",
                "claude-opus-5",
                "claude-opus-4.8",
                "claude-opus-4.7",
                "claude-opus-4.6",
                "claude-sonnet-5.5",
                "claude-sonnet-5",
                "claude-sonnet-4.6",
                "claude-haiku-5.5",
                "glm-5.3",
                "glm-5.3-flash",
                "glm-5.3-flashx",
                "glm-5.2",
                "kimi-k3",
                "kimi-k2.7-code",
                "kimi-k2.7-code-highspeed",
                "qwen3.8-max",
                "qwen3.7-max",
                "qwen3.7-plus",
                "qwen3.8-flash",
                "qwen3.7-flash",
                "qwen3.8-2.4t-a95b",
                "qwen3.8-27b",
                "qwen3.8-omni-flash",
                "gemini-3.8-flash",
                "gemini-3.5-flash-lite",
                "gemini-3.1-pro-preview",
                "minimax-m3",
                "minimax-m3.1-flash-preview",
                "kimi-for-coding"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One model",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelItem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown vendor / model (GitHub Pages 404 page, not JSON)"
          }
        }
      }
    },
    "/vendors.json": {
      "get": {
        "operationId": "listVendors",
        "summary": "All vendors",
        "responses": {
          "200": {
            "description": "All vendors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VendorList"
                }
              }
            }
          },
          "404": {
            "description": "Unknown vendor / model (GitHub Pages 404 page, not JSON)"
          }
        }
      }
    },
    "/vendors/{vendor}.json": {
      "get": {
        "operationId": "getVendor",
        "summary": "One vendor and its models",
        "parameters": [
          {
            "name": "vendor",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "deepseek",
                "openai",
                "anthropic",
                "zhipu",
                "moonshot",
                "qwen",
                "google",
                "minimax"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vendor with its models",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VendorModels"
                }
              }
            }
          },
          "404": {
            "description": "Unknown vendor / model (GitHub Pages 404 page, not JSON)"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Meta": {
        "type": "object",
        "required": [
          "updated_at",
          "currency",
          "unit",
          "unit_label"
        ],
        "properties": {
          "updated_at": {
            "type": "string",
            "format": "date",
            "description": "Dataset last-verified date"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "per_1M_tokens"
            ]
          },
          "unit_label": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "description": "Number of items in data"
          },
          "scope": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Model": {
        "type": "object",
        "required": [
          "id",
          "name",
          "vendor",
          "vendor_name",
          "currency",
          "unit",
          "pricing",
          "pricing_status",
          "has_off_peak",
          "off_peak_pricing",
          "peak_note",
          "context_length",
          "context_length_label",
          "source_url",
          "extra_sources",
          "last_updated",
          "notes",
          "reasoning_effort",
          "limits",
          "pricing_tiers",
          "service_tiers",
          "cache_pricing",
          "modalities",
          "features",
          "knowledge_cutoff",
          "thinking_budget",
          "availability",
          "price_schedule",
          "snapshot",
          "aliases",
          "unverified_fields",
          "links"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Model id as used in the vendor API; also the file name of /models/{model_id}.json"
          },
          "name": {
            "type": "string",
            "description": "Display name"
          },
          "vendor": {
            "type": "string",
            "description": "Vendor slug",
            "enum": [
              "deepseek",
              "openai",
              "anthropic",
              "zhipu",
              "moonshot",
              "qwen",
              "google",
              "minimax"
            ]
          },
          "vendor_name": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "per_1M_tokens"
            ]
          },
          "pricing": {
            "type": "object",
            "description": "Standard price (peak price when off-peak pricing exists)",
            "required": [
              "input",
              "output",
              "cached_input",
              "cache_write"
            ],
            "properties": {
              "input": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "USD per 1M tokens; null when not listed or unverified (see pricing_status)"
              },
              "output": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "USD per 1M tokens; null when not listed or unverified (see pricing_status)"
              },
              "cached_input": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "Cache hit / cache read price"
              },
              "cache_write": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "Cache write (creation) price"
              }
            }
          },
          "pricing_status": {
            "type": "object",
            "required": [
              "input",
              "output",
              "cached_input",
              "cache_write"
            ],
            "properties": {
              "input": {
                "type": "string",
                "enum": [
                  "verified",
                  "unverified",
                  "not_listed"
                ],
                "description": "verified = from official page; unverified = 待核实 (could not be verified); not_listed = official page has no such item (未列出)"
              },
              "output": {
                "type": "string",
                "enum": [
                  "verified",
                  "unverified",
                  "not_listed"
                ],
                "description": "verified = from official page; unverified = 待核实 (could not be verified); not_listed = official page has no such item (未列出)"
              },
              "cached_input": {
                "type": "string",
                "enum": [
                  "verified",
                  "unverified",
                  "not_listed"
                ],
                "description": "verified = from official page; unverified = 待核实 (could not be verified); not_listed = official page has no such item (未列出)"
              },
              "cache_write": {
                "type": "string",
                "enum": [
                  "verified",
                  "unverified",
                  "not_listed"
                ],
                "description": "verified = from official page; unverified = 待核实 (could not be verified); not_listed = official page has no such item (未列出)"
              }
            }
          },
          "has_off_peak": {
            "type": "boolean"
          },
          "off_peak_pricing": {
            "type": [
              "object",
              "null"
            ],
            "description": "Off-peak (闲时) price, null if none",
            "properties": {
              "input": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "USD per 1M tokens; null when not listed or unverified (see pricing_status)"
              },
              "output": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "USD per 1M tokens; null when not listed or unverified (see pricing_status)"
              },
              "cached_input": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "USD per 1M tokens; null when not listed or unverified (see pricing_status)"
              }
            }
          },
          "peak_note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Peak / off-peak schedule or time-limited price note"
          },
          "context_length": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Context window in tokens"
          },
          "context_length_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "description": "Official pricing page"
          },
          "extra_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "last_updated": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasoning_effort": {
            "type": "object",
            "description": "Reasoning-effort / thinking-intensity support from official vendor docs. null = 待核实 (not verified, never guessed).",
            "required": [
              "supported",
              "levels",
              "default",
              "can_disable",
              "status",
              "note",
              "sources"
            ],
            "properties": {
              "supported": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "true = the API exposes an adjustable reasoning effort / thinking switch or budget; false = no adjustable control (e.g. always-on thinking with no effort parameter); null = 待核实"
              },
              "levels": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Accepted effort levels in ascending order (e.g. low, medium, high); null when not applicable or 待核实"
              },
              "default": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Default level when the parameter is omitted; null when not stated / 待核实"
              },
              "can_disable": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Whether reasoning can be turned off via the API; null = not stated in official docs"
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "partial",
                  "unverified"
                ],
                "description": "verified = documented; partial = some facts documented but levels/default 待核实; unverified = 待核实"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Parameter names, level mappings and caveats"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "Official documentation pages used"
              }
            }
          },
          "limits": {
            "type": "object",
            "description": "Token limits from official pages. null = 待核实 (not verified, never guessed). Official K/M labels are recorded as 1K=1,000 / 1M=1,000,000 unless the page gives exact numbers (see note).",
            "required": [
              "max_input_tokens",
              "max_output_tokens",
              "context_length",
              "max_input_tokens_thinking",
              "max_output_tokens_thinking",
              "max_reasoning_tokens",
              "max_output_tokens_batch_beta",
              "default_output_tokens",
              "status",
              "note",
              "sources"
            ],
            "properties": {
              "max_input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Maximum input tokens per request (non-thinking mode where the vendor distinguishes)"
              },
              "max_output_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Maximum output tokens per request"
              },
              "context_length": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Context window in tokens (same value as top-level context_length)"
              },
              "max_input_tokens_thinking": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Maximum input tokens in thinking mode, when documented separately"
              },
              "max_output_tokens_thinking": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Maximum output tokens in thinking mode, when documented separately"
              },
              "max_reasoning_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Maximum chain-of-thought / reasoning tokens (Qwen: Max Chain-of-Thought Length)"
              },
              "max_output_tokens_batch_beta": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Higher output limit on the batch API behind a beta header (Anthropic: 300K)"
              },
              "default_output_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Default max output tokens when the request omits it, if documented"
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "partial",
                  "unverified"
                ],
                "description": "verified = max_input_tokens, max_output_tokens and context_length all known; partial = some; unverified = none"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "pricing_tiers": {
            "type": "array",
            "description": "Long-context / prompt-length price tiers where documented, in addition to the base price in pricing (which is the lowest tier). Empty array = single tier (or tiers not documented). A request whose input falls in a tier is billed entirely at that tier's prices. A null price inside a tier = not documented for that tier.",
            "items": {
              "type": "object",
              "required": [
                "condition",
                "input_tokens_gt",
                "input_tokens_lte",
                "input",
                "output",
                "cached_input",
                "cache_write",
                "cache_pricing",
                "note"
              ],
              "properties": {
                "condition": {
                  "type": "string",
                  "description": "Machine-readable condition, e.g. input_tokens>272000"
                },
                "input_tokens_gt": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Tier applies when input tokens > this value"
                },
                "input_tokens_lte": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "…and <= this value (null = no upper bound)"
                },
                "input": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "USD per 1M tokens; null when not listed or unverified (see pricing_status)"
                },
                "output": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "USD per 1M tokens; null when not listed or unverified (see pricing_status)"
                },
                "cached_input": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "Same meaning as pricing.cached_input, at this tier"
                },
                "cache_write": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "Same meaning as pricing.cache_write, at this tier"
                },
                "cache_pricing": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CachePricing"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "service_tiers": {
            "type": "array",
            "description": "Documented service-tier price multipliers applied to the standard price (all of input, output and cache prices). Only tiers documented for this model are listed.",
            "items": {
              "type": "object",
              "required": [
                "name",
                "multiplier",
                "note"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "enum": [
                    "batch",
                    "flex",
                    "fast",
                    "priority",
                    "ultrafast",
                    "data_residency"
                  ],
                  "description": "batch / flex / fast (OpenAI Fast = formerly Priority; Anthropic fast mode) / priority / ultrafast; data_residency = regional / US-only processing surcharge"
                },
                "multiplier": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Price multiplier vs standard, e.g. 0.5 or 2"
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "cache_pricing": {
            "$ref": "#/components/schemas/CachePricing"
          },
          "modalities": {
            "type": "object",
            "required": [
              "input",
              "output",
              "unsupported",
              "sources"
            ],
            "description": "Input / output modalities documented on official pages. null = 待核实.",
            "properties": {
              "input": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "output": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "unsupported": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Modalities the official page explicitly lists as unsupported"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "features": {
            "type": "object",
            "required": [
              "supported",
              "unsupported",
              "tools",
              "status",
              "note",
              "sources"
            ],
            "description": "Capabilities documented on official model pages (snake_case names as in the vendor docs). supported/unsupported are only what the official page states; a feature missing from both lists is 待核实, not unsupported.",
            "properties": {
              "supported": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "unsupported": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "tools": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Built-in tools supported (OpenAI Responses API)"
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "partial",
                  "unverified"
                ],
                "description": "verified = the vendor page lists capabilities completely; partial = list not exhaustive; unverified = 待核实"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "knowledge_cutoff": {
            "type": [
              "object",
              "null"
            ],
            "description": "Knowledge cutoff from official pages; null = not stated / 待核实",
            "required": [
              "date",
              "training_data_date",
              "note"
            ],
            "properties": {
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "YYYY-MM-DD or YYYY-MM"
              },
              "training_data_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "thinking_budget": {
            "type": "object",
            "required": [
              "supported",
              "min",
              "max",
              "default",
              "note",
              "sources"
            ],
            "description": "Token budget for thinking / chain-of-thought (budget_tokens / thinking_budget). supported: true = parameter exists, false = documented as not accepted, null = 待核实. Distinct from reasoning_effort levels.",
            "properties": {
              "supported": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "min": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "default": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "availability": {
            "type": "object",
            "required": [
              "status",
              "note"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "general",
                  "limited",
                  "subscription_only"
                ],
                "description": "general = pay-as-you-go API; limited = restricted access (verification program); subscription_only = only via a subscription product, no pay-as-you-go price"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "price_schedule": {
            "type": "array",
            "description": "Time-limited promotions and scheduled price changes announced on official pages (price fields are the announced prices; null = not announced)",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "effective_from",
                "effective_until",
                "input",
                "output",
                "cached_input",
                "cache_write",
                "note"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "promotion",
                    "scheduled_increase",
                    "scheduled_decrease"
                  ]
                },
                "effective_from": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "effective_until": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "input": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "USD per 1M tokens; null when not listed or unverified (see pricing_status)"
                },
                "output": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "USD per 1M tokens; null when not listed or unverified (see pricing_status)"
                },
                "cached_input": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "USD per 1M tokens; null when not listed or unverified (see pricing_status)"
                },
                "cache_write": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "USD per 1M tokens; null when not listed or unverified (see pricing_status)"
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "snapshot": {
            "type": [
              "string",
              "null"
            ],
            "description": "Dated snapshot / version this model id currently resolves to, if documented"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Other model names still accepted by the vendor API"
          },
          "unverified_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "links": {
            "type": "object",
            "properties": {
              "self": {
                "type": "string"
              },
              "vendor": {
                "type": "string"
              }
            }
          }
        }
      },
      "Vendor": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "model_count",
          "model_ids",
          "source_urls",
          "links"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "enum": [
              "deepseek",
              "openai",
              "anthropic",
              "zhipu",
              "moonshot",
              "qwen",
              "google",
              "minimax"
            ]
          },
          "name": {
            "type": "string"
          },
          "model_count": {
            "type": "integer"
          },
          "model_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "links": {
            "type": "object",
            "properties": {
              "self": {
                "type": "string"
              }
            }
          }
        }
      },
      "CachePricing": {
        "type": "object",
        "required": [
          "implicit_read",
          "explicit_read",
          "explicit_write",
          "explicit_write_1h",
          "storage_per_1M_tokens_hour",
          "note"
        ],
        "description": "Cache price breakdown where documented (USD per 1M tokens; null = not documented / 待核实). pricing.cached_input and pricing.cache_write keep their meaning; this object adds the finer split. Qwen: implicit_read / explicit_read / explicit_write are the three official cache prices.",
        "properties": {
          "implicit_read": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Implicit (automatic) cache hit price"
          },
          "explicit_read": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Explicit cache hit (read) price"
          },
          "explicit_write": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Cache creation / write price (5-minute TTL where TTLs exist)"
          },
          "explicit_write_1h": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "1-hour TTL cache write price (Anthropic, Kimi K3)"
          },
          "storage_per_1M_tokens_hour": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Cache storage fee per 1M tokens per hour (USD, not per 1M tokens; 0 = currently free)"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ModelList": {
        "type": "object",
        "required": [
          "api_version",
          "meta",
          "data"
        ],
        "properties": {
          "api_version": {
            "type": "string",
            "enum": [
              "v1"
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Model"
            }
          }
        }
      },
      "ModelItem": {
        "type": "object",
        "required": [
          "api_version",
          "meta",
          "data"
        ],
        "properties": {
          "api_version": {
            "type": "string",
            "enum": [
              "v1"
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "data": {
            "$ref": "#/components/schemas/Model"
          }
        }
      },
      "VendorList": {
        "type": "object",
        "required": [
          "api_version",
          "meta",
          "data"
        ],
        "properties": {
          "api_version": {
            "type": "string",
            "enum": [
              "v1"
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vendor"
            }
          }
        }
      },
      "VendorModels": {
        "type": "object",
        "required": [
          "api_version",
          "meta",
          "data",
          "vendor"
        ],
        "properties": {
          "api_version": {
            "type": "string",
            "enum": [
              "v1"
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Model"
            }
          },
          "vendor": {
            "$ref": "#/components/schemas/Vendor"
          }
        }
      }
    }
  }
}
